  "cards": [
    {
      "dot": "cyan",
      "title": "核心链路(事件驱动)",
      "items": [
        "上传:分片直传 MinIO(预签名)→ 秒传/断点续传 → VIDEO_UPLOADED 事件",
        "机审:画面规则 + DFA 敏感词(REJECT/REVIEW 分级,词库热更新)",
        "人工:审核认领软锁 → 决策硬锁 → VIDEO_APPROVED 事件",
        "转码:虚拟线程 + ffmpeg HLS 多码率 → PUBLISHED",
        "播放:网关代理 MinIO HLS;Artplayer + 弹幕插件"
      ]
    },
    {
      "dot": "amber",
      "title": "未画出的交互(详见技术文档)",
      "items": [
        "网关→moderation/media 路由与 /media 代理;media→video Feign 回写",
        "video→MinIO 分片直传/秒传;moderation→MinIO 拉原片机审",
        "video→Redis 列表缓存/播放计数;全部服务注册/配置于 Nacos",
        "MQ 重试+死信;布隆过滤器;跨服务删除级联清理"
      ]
    }
  ]
